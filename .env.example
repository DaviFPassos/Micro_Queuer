# ============================================================================
# CONFIGURAÇÕES DE EXEMPLO - NUNCA COMMITAR COM VALORES REAIS
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores

# Configurações do Gateway (Go)
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
MAX_PAYLOAD_SIZE=5242880

# Configurações do Worker (Python)
WORKER_SLEEP_TIME=0.5
QUEUE_POLL_INTERVAL=1
MAX_RETRIES=3

# Configurações de Segurança
API_KEY=seu-api-key-aqui
SECRET_TOKEN=seu-token-secreto-aqui
DEBUG=false

# Configurações de Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
